# Variables d'environnement - Production MesAbos Backend
# ======================================================
# ATTENTION: Ce fichier contient des valeurs sensibles
# NE JAMAIS COMMITER ce fichier avec de vraies valeurs

# Environment
NODE_ENV=production

# Port du serveur
PORT=3000

# Base de données PostgreSQL (Production)
DATABASE_URL="postgresql://username:password@production_host:5432/database_name"

# JWT Configuration (Production - Valeurs critiques)
# Générez une clé sécurisée différente de celle de développement
JWT_SECRET=your_production_jwt_secret_here_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=24h

# Google OAuth (Production)
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret

# Configuration CORS automatique pour la production:
# - https://mesabos.com
# - https://www.mesabos.com