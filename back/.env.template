# Variables d'environnement - Template MesAbos Backend
# =======================================================
# Copiez ce fichier vers .env.development ou .env.production
# et remplissez les valeurs appropriées

# Environment (development | production)
NODE_ENV=development

# Port du serveur
PORT=3000

# Base de données PostgreSQL
# Développement: postgresql://mesabos_user:mesabos_password@localhost:5432/mesabos_dev
# Production: postgresql://username:password@host:5432/database_name
DATABASE_URL="postgresql://username:password@host:5432/database_name"

# JWT Configuration
# Générez une clé sécurisée avec: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Google OAuth (Authentification sociale)
# Obtenez ces valeurs depuis Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Configuration CORS (automatiquement gérée par le code selon NODE_ENV)
# Développement: http://localhost:4200, http://127.0.0.1:4200
# Production: https://mesabos.com, https://www.mesabos.com

# =====================================================
# INSTRUCTIONS:
# 1. Copiez ce fichier: cp .env.template .env.development
# 2. Générez JWT_SECRET: openssl rand -hex 32
# 3. Configurez DATABASE_URL selon votre environnement
# 4. Remplissez les identifiants Google OAuth
# =====================================================